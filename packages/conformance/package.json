{
  "name": "@stratasync/conformance",
  "version": "2.4.1",
  "description": "@stratasync/conformance: the language-agnostic conformance corpus for Strata Sync, an open-source implementation of Linear's sync engine. Golden vectors, engine scenarios and a driver protocol every implementation must pass.",
  "keywords": [
    "conformance",
    "cross-platform",
    "golden-vectors",
    "linear",
    "linear-sync-engine",
    "local-first",
    "parity",
    "sync",
    "sync-engine",
    "test-vectors",
    "typescript"
  ],
  "homepage": "https://blode.co/stratasync/docs/packages/conformance",
  "bugs": {
    "url": "https://github.com/mblode/stratasync/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Matthew Blode",
    "url": "https://blode.co"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mblode/stratasync.git",
    "directory": "packages/conformance"
  },
  "files": [
    "corpus",
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./corpus/*": "./corpus/*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "dev": "tsc --watch -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "corpus:manifest": "node --experimental-strip-types scripts/build-manifest.ts"
  },
  "devDependencies": {
    "ajv": "^8.17.1"
  },
  "engines": {
    "node": ">=22"
  }
}
