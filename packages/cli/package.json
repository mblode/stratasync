{
  "name": "stratasync",
  "version": "2.4.1",
  "description": "stratasync: the CLI for Strata Sync, an open-source implementation of Linear's sync engine. `npx stratasync init my-app` scaffolds a runnable local-first app with a Fastify + Postgres sync server and a React client.",
  "keywords": [
    "cli",
    "create",
    "linear",
    "linear sync engine",
    "local-first",
    "offline-first",
    "scaffold",
    "sync",
    "sync-engine",
    "typescript"
  ],
  "homepage": "https://blode.co/stratasync/docs/getting-started",
  "bugs": {
    "url": "https://github.com/mblode/stratasync/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Matthew Blode",
    "url": "https://blode.co"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mblode/stratasync.git",
    "directory": "packages/cli"
  },
  "bin": {
    "stratasync": "./dist/cli.js"
  },
  "files": [
    "dist",
    "template",
    "src",
    "!src/**/*.test.*"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist template && node scripts/build-template.mjs && tsc -p tsconfig.build.json",
    "dev": "tsc --watch -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "commander": "^15.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
