{
  "name": "@stratasync/transport-graphql",
  "version": "2.0.0",
  "description": "@stratasync/transport-graphql: GraphQL + WebSocket transport adapter for Strata Sync, an open-source implementation of Linear's sync engine.",
  "keywords": [
    "fetch",
    "graphql",
    "linear",
    "linear sync engine",
    "linear-sync-engine",
    "local-first",
    "offline-first",
    "realtime",
    "sync",
    "sync-engine",
    "transport",
    "typescript",
    "websocket"
  ],
  "homepage": "https://blode.co/stratasync/docs/packages/transport-graphql",
  "bugs": {
    "url": "https://github.com/mblode/stratasync/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Matthew Blode",
    "url": "https://blode.co"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mblode/stratasync.git",
    "directory": "packages/transport-graphql"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "dev": "tsc --watch -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@stratasync/client": "*",
    "@stratasync/core": "*",
    "@stratasync/y-doc": "*"
  },
  "engines": {
    "node": ">=22"
  }
}
