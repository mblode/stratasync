{
  "name": "@stratasync/y-doc",
  "version": "2.3.1",
  "description": "@stratasync/y-doc: Yjs CRDT documents and presence for Strata Sync, an open-source implementation of Linear's sync engine.",
  "keywords": [
    "collaborative-editing",
    "crdt",
    "linear",
    "linear sync engine",
    "linear-sync-engine",
    "local-first",
    "offline-first",
    "presence",
    "prosemirror",
    "realtime",
    "sync",
    "sync-engine",
    "typescript",
    "yjs"
  ],
  "homepage": "https://blode.co/stratasync/docs/packages/y-doc",
  "bugs": {
    "url": "https://github.com/mblode/stratasync/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Matthew Blode",
    "url": "https://blode.co"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mblode/stratasync.git",
    "directory": "packages/y-doc"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "dev": "tsc --watch -p tsconfig.build.json",
    "check-types": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "yjs": "^13.6.0"
  },
  "engines": {
    "node": ">=22"
  }
}
