{
  "name": "@stratasync/storage-idb",
  "version": "2.2.0",
  "description": "@stratasync/storage-idb: IndexedDB storage adapter for Strata Sync, an open-source implementation of Linear's sync engine.",
  "keywords": [
    "browser",
    "idb",
    "indexeddb",
    "linear",
    "linear sync engine",
    "linear-sync-engine",
    "local-first",
    "offline-first",
    "realtime",
    "storage",
    "sync",
    "sync-engine",
    "typescript"
  ],
  "homepage": "https://blode.co/stratasync/docs/packages/storage-idb",
  "bugs": {
    "url": "https://github.com/mblode/stratasync/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Matthew Blode",
    "url": "https://blode.co"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mblode/stratasync.git",
    "directory": "packages/storage-idb"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "dev": "tsc --watch -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@stratasync/client": "*",
    "@stratasync/core": "*",
    "idb": "^8.0.3"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.5"
  },
  "engines": {
    "node": ">=22"
  }
}
