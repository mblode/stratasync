{
  "name": "@stratasync/react",
  "version": "2.3.1",
  "description": "@stratasync/react: React provider and hooks for Strata Sync, an open-source implementation of Linear's sync engine.",
  "keywords": [
    "collaborative-editing",
    "linear",
    "linear sync engine",
    "linear-sync-engine",
    "local-first",
    "offline-first",
    "react",
    "react-hooks",
    "realtime",
    "suspense",
    "sync",
    "sync-engine",
    "typescript",
    "yjs"
  ],
  "homepage": "https://blode.co/stratasync/docs/packages/react",
  "bugs": {
    "url": "https://github.com/mblode/stratasync/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Matthew Blode",
    "url": "https://blode.co"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mblode/stratasync.git",
    "directory": "packages/react"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "dev": "tsc --watch -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@stratasync/client": "*",
    "@stratasync/core": "*"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^29.0.1",
    "mobx": "^6.15.0",
    "mobx-react-lite": "^4.1.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "yjs": "^13.6.0"
  },
  "peerDependenciesMeta": {
    "yjs": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
