{
  "name": "@stratasync/mobx",
  "version": "2.1.1",
  "description": "@stratasync/mobx: MobX reactivity adapter for Strata Sync, an open-source implementation of Linear's sync engine.",
  "keywords": [
    "linear",
    "linear sync engine",
    "linear-sync-engine",
    "local-first",
    "mobx",
    "observable",
    "offline-first",
    "reactivity",
    "realtime",
    "sync",
    "sync-engine",
    "typescript"
  ],
  "homepage": "https://blode.co/stratasync/docs/packages/mobx",
  "bugs": {
    "url": "https://github.com/mblode/stratasync/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Matthew Blode",
    "url": "https://blode.co"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mblode/stratasync.git",
    "directory": "packages/mobx"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/adapter.js"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "dev": "tsc --watch -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@stratasync/core": "*"
  },
  "devDependencies": {
    "mobx": "^6.15.0"
  },
  "peerDependencies": {
    "mobx": "^6.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
